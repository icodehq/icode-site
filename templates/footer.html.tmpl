<footer class="site-footer">
  <div class="site-footer-inner">
    <p class="site-footer-brand">{{footer.tagline}}</p>
    <p class="site-footer-links">
      <a href="{{workbench_href}}">{{footer.workbench}}</a>
      <a href="{{agent_href}}">{{footer.agent}}</a>
      <a href="{{get_started_href}}">{{footer.getStarted}}</a>
      <a href="{{guides_href}}">{{footer.guides}}</a>
      <a href="{{blog_href}}">{{footer.blog}}</a>
      <a href="{{faq_href}}">{{footer.faq}}</a>
      <a href="{{about_href}}">{{footer.about}}</a>
      <a href="{{github_url}}" rel="noopener">{{footer.github}}</a>
    </p>
    {{authoritative_note}}
    <p class="site-footer-copy">{{footer.copy}}</p>
  </div>
</footer>
